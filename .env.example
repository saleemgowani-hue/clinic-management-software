# Copy this file to .streamlit/secrets.toml (for Streamlit Cloud / local
# testing) OR set these as real environment variables on your server —
# either works, DATABASE_URL is checked in both places.
#
# NEVER commit your actual secrets.toml or .env to git — only this
# .example file should be checked in.

# --- Required: switches the app into Online (PostgreSQL) mode ---
# Any PostgreSQL 13+ works: Supabase, Neon, Render, Railway, ElephantSQL,
# your own server, etc. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL = "postgresql://username:password@host:5432/dbname"

# --- Optional: Razorpay (only if you want online plan payments) ---
# RAZORPAY_KEY_ID = "rzp_live_xxxxxxxx"
# RAZORPAY_KEY_SECRET = "your_key_secret"
